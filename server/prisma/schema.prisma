generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Gallery {
  id          String   @id @default(cuid())
  url         String
  title       String
  description String
  category    String
  date        DateTime
  localImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model News {
  id        String   @id @default(cuid())
  title     String
  content   String
  date      DateTime
  image     String?
  localImage String?
  author    String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model Event {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  location    String
  description String
  category    String
  image       String?
  localImage  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([category])
}

model Instructor {
  id                String   @id @default(cuid())
  name              String
  bio               String
  level             String
  certificationCode String   @unique
  photo             String
  localPhoto        String?
  experienceYears   Int
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  graduates         Graduate[]

  @@index([experienceYears])
}

model Graduate {
  id                String   @id @default(cuid())
  name              String
  certificationCode String   @unique
  courseName        String
  graduationDate    DateTime
  instructorName    String
  level             String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instructorId      String?
  instructor        Instructor? @relation(fields: [instructorId], references: [id])

  @@index([graduationDate])
  @@index([level])
  @@index([instructorId])
}

model AdminUser {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RateLimit {
  id        String   @id @default(cuid())
  key       String   @unique
  attempts  Int      @default(1)
  resetAt   DateTime
  createdAt DateTime @default(now())

  @@index([key])
}
